# Public Supabase project configuration. The publishable key is designed for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional browser key for the seeded-location map preview. Restrict it to your web origins and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Used by next.config.ts on the server. Do not rename this to NEXT_PUBLIC_API_ORIGIN.
API_ORIGIN=http://127.0.0.1:8080
